<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- CUE4Parse kohdistaa net10.0:aan, joten tama on pakko seurata sita.
         Vaatii .NET SDK 10:n - bootstrap.py tarkistaa sen. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DumpWorld</AssemblyName>
    <RootNamespace>DumpWorld</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- tools/bootstrap.py kloonaa CUE4Parsen tanne pinnattuun kommittiin. -->
    <ProjectReference Include="..\..\..\tools\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="..\..\..\tools\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
  </ItemGroup>
  <!-- Ei yhtaan PackageReferencea: CUE4Parse kayttaa keskitettya paketinhallintaa
       eksakteilla versiopinneilla, ja omat pinnit vain riitelisivat niiden kanssa.
       JSON hoituu System.Text.Jsonilla joka tulee runtimen mukana.
       Natiivikirjastot (CMake) ohitetaan kaannoskomennon -p:CUE4PARSE_SKIP_NATIVE=true
       -lipulla; ne ovat vain animaatioiden purkuun. -->
</Project>
